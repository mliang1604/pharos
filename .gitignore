# ============================================================
# Game-engine specific
# ============================================================

# ---------- Generated/baked assets ----------
# Keep source assets (in e.g. assets/source/) committed; ignore the
# baked/compressed outputs of your asset pipeline.
assets/baked/
assets/dist/
assets/compressed/
*.ktx2.bak
*.basis.bak

# Large binary asset formats — uncomment if you're NOT using Git LFS.
# If you ARE using Git LFS, leave these tracked and configure .gitattributes.
# *.fbx
# *.blend
# *.blend1
# *.psd
# *.exr
# *.hdr
# *.tga
# *.wav
# *.flac
# *.aif
# *.mp4
# *.mov

# Blender autosaves
*.blend1
*.blend2
*.blend@

# Generated shader caches / reflection data
.shadercache/
*.spv.cache
*.wgsl.cache

# Generated TypeScript bindings from WGSL (if you set this up later)
src/generated/

# ---------- Profiling / captures ----------
*.gpucapture
*.rgp
*.nvprof
*.rdc
captures/
profiles/

# ============================================================
# Rust / wgpu (for future native port — safe to keep now)
# ============================================================
target/
**/*.rs.bk
Cargo.lock.bak
# Note: commit Cargo.lock for binaries, ignore it for libraries.
# Decide later; default here is to keep it tracked.

# ============================================================
# WebAssembly artifacts (Rapier physics, etc.)
# ============================================================
pkg/
*.wasm.map
wasm-pack.log

# ============================================================
# Documentation build output
# ============================================================
docs/.vitepress/dist/
docs/.vitepress/cache/
typedoc/
api-docs/

# ============================================================
# Obsidian vaults (pharos-notes/, etc.)
# ============================================================
# Per-user / per-machine UI state that changes on every interaction.
# Commit the notes and shared vault config; ignore the local layout.
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/graph.json
**/.obsidian/cache/
**/.trash/


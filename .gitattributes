# Normalize line endings: store text as LF in the repo and check it out as LF
# on every platform, so the working tree matches Prettier's endOfLine: lf.
* text=auto eol=lf

# Explicitly treat known binary types as binary (never touch their bytes).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ktx2 binary

{
  "name": "pharos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A WebGPU game engine built in TypeScript.",
  "license": "See LICENSE",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.19.41",
    "@webgpu/types": "^0.1.70",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "wgpu-matrix": "^3.4.2"
  }
}
